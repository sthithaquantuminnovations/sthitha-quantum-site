---
import Legal from '../layouts/Legal.astro';
import { company } from '../data/site.js';

const sections = [
  { id: 'agreement', title: 'Acceptance of Terms' },
  { id: 'about-sthitha', title: 'About Sthitha & Scope of Services' },
  { id: 'advisory-disclaimer', title: 'Technical & Educational Disclaimer' },
  { id: 'academy-courses', title: 'Sthitha Academy & Course Delivery' },
  { id: 'intellectual-property', title: 'Intellectual Property Rights' },
  { id: 'user-conduct', title: 'Acceptable Use & Security Restrictions' },
  { id: 'confidentiality', title: 'Inquiries & Enterprise Information' },
  { id: 'disclaimer-warranties', title: 'Disclaimer of Warranties' },
  { id: 'limitation-liability', title: 'Limitation of Liability' },
  { id: 'indemnification', title: 'Indemnification' },
  { id: 'third-party-links', title: 'Third-Party Links & Resources' },
  { id: 'termination', title: 'Termination & Access Suspension' },
  { id: 'governing-law', title: 'Governing Law & Jurisdiction' },
  { id: 'dispute-resolution', title: 'Dispute Resolution & Arbitration' },
  { id: 'severability', title: 'Severability & Entire Agreement' },
  { id: 'contact-notices', title: 'Legal Notices & Contact Information' },
];
---

<Legal
  title="Terms & Conditions"
  summary="The terms and governing provisions regulating access to and use of Sthitha Quantum Innovations websites, research publications, and educational offerings."
  updated="13 October 2026"
  sections={sections}
>
