
---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | Sthitha Quantum Innovations"
  description="The page you are looking for could not be found. Explore Sthitha Quantum Innovations."
>
  <div class="frame">
    <section class="page-hero">
      <div class="page-hero-body">
        <div>
          <p class="eyebrow">404 · Page not found</p>

          <h1 data-reveal>
            Looks like this page is out of orbit.
          </h1>

          <p class="page-hero-lede" data-fade>
            The page you are looking for may have moved,
            or the link may be incorrect. Let's get you
            back on track.
          </p>

          <div class="hero-actions" data-fade>
            <a class="btn btn-light" href="/">
              Back to Home
            </a>

            <a class="btn btn-dark" href="/contact">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
