
---
import Base from '../layouts/Base.astro';

const teamMembers = [
  {
    name: 'Anil Erinchikkadavathu Achoora',
    photo: '/assets/team/anil-achoora.webp',
    role: 'Founder & Director',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'A',
    linkedIn: 'https://www.linkedin.com/in/anil-achoora-550a8a35',
  },
  {
    name: 'Dr. Bhowmik Kaustav',
    photo: '/assets/team/dr-bhowmik-kaustav.webp',
    role: 'Director',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'B',
    linkedIn: '',
  },
  {
    name: 'Asif Shah',
    photo: '/assets/team/asif-shah.webp',
    photoPosition: 'center top',
    role: 'Research Head',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'A',
    linkedIn: 'https://www.linkedin.com/in/asif-shah-a9ab90183/',
    scholar: 'https://scholar.google.com/citations?user=ZlI6XToAAAAJ&hl=en&oi=ao',
    highlights: [
      "Awarded the Prime Minister's Research Fellowship (PMRF) during Ph.D.",
      'Research internship at imec, Belgium',
    ],
    // Add a `title` to each paper once confirmed; until then the publisher name is shown.
    publications: [
      { publisher: 'Nature Portfolio', href: 'https://www.nature.com/articles/s41699-024-00518-0' },
      { publisher: 'ACS Applied Materials & Interfaces', href: 'https://pubs.acs.org/aamick/article-abstract/18/14/20763/5142477/Revealing-the-Origins-of-Thermally-Induced-Anomaly?redirectedFrom=fulltext' },
      { publisher: 'IEEE Xplore', href: 'https://ieeexplore.ieee.org/abstract/document/10299616' },
      { publisher: 'Springer', href: 'https://link.springer.com/article/10.1007/s11554-020-01008-4' },
    ],
  },
  {
    name: 'Rantish Valathe Rajan',
    photo: '/assets/team/rantish-valathe-rajan.webp',
    role: 'CTO',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'R',
    linkedIn: '',
  },
  {
    name: 'Farhan',
    photo: '/assets/team/farhan.webp',
    role: 'CFO',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'F',
    linkedIn: 'https://www.linkedin.com/in/k-muhammed-farhaan-169956234',
  },
  {
    name: 'Punya Jayarajan',
    photo: '/assets/team/punya-jayarajan.webp',
    role: 'Creative Design Head',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'P',
    linkedIn: 'https://www.linkedin.com/in/punya-jayarajan',
  },
  {
    name: 'Harigovind M',
    photo: '/assets/team/harigovind-m.webp',
    role: 'Marketing Head',
    bio: 'Add a short, approved introduction about this team member and their work at Sthitha.',
    initials: 'H',
    linkedIn: 'https://www.linkedin.com/in/harigovind-m',
  },
];
---

<Base
  title="Our Team | Sthitha Quantum Innovations"
  description="Meet the core team behind Sthitha Quantum Innovations and learn about the people working across quantum computing, education, research and post-quantum security."
>
  <div class="frame team-page">
    <section class="team-hero">
      <div class="team-hero-content">
        <span class="eyebrow">
          Sthitha Quantum Innovations
        </span>

        <h1 data-reveal>
          The people behind<br />
          <span>the possibilities.</span>
        </h1>

        <p class="team-intro" data-fade style="--d: 180ms">
          Meet the core team working across quantum computing,
          post-quantum security, education and research.
        </p>
      </div>

      <div class="team-hero-note" data-fade style="--d: 260ms">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Our team · Our work · Our direction</span>
      </div>
    </section>

    <section class="team-section" aria-labelledby="team-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">The people</span>
          <h2 id="team-heading" data-reveal>
            Meet our core team
          </h2>
        </div>

        <p class="section-description">
          The people contributing to Sthitha's work and vision
          in emerging quantum technologies.
        </p>
      </div>

      <div class="team-grid">
        {teamMembers.map((member, index) => (
          <article
            class="team-card"
            data-fade
            style={`--d: ${index * 90}ms`}
          >
            <div class="member-portrait">
              {member.photo ? (
                <img src={member.photo} alt={member.name} width="800" loading="lazy" decoding="async" style={member.photoPosition ? `object-position: ${member.photoPosition}` : undefined} />
              ) : (
                <svg class="portrait-silhouette" viewBox="0 0 120 120" aria-hidden="true">
                  <circle cx="60" cy="44" r="19" />
                  <path d="M20 112c0-22 17-38 40-38s40 16 40 38" />
                </svg>
              )}
            </div>

            <div class="member-info">
              <div class="member-heading">
                <div>
                  <h3>{member.name}</h3>
                  <p class="member-role">{member.role}</p>
                </div>

              </div>

              {(member.linkedIn || member.scholar) && (
                <div class="member-links">
                  {member.linkedIn && (
                    <a class="member-link" href={member.linkedIn} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn (opens in a new tab)`} title="LinkedIn">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14ZM8.34 17.5V9.2H5.58v8.3h2.76ZM6.96 8.07a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2ZM18.42 17.5v-4.55c0-2.44-1.3-3.58-3.03-3.58a2.62 2.62 0 0 0-2.36 1.3V9.2h-2.76v8.3h2.76v-4.1c0-1.08.2-2.12 1.54-2.12s1.36 1.23 1.36 2.19v4.03h2.49Z"/></svg>
                    </a>
                  )}
                  {member.scholar && (
                    <a class="member-link" href={member.scholar} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Google Scholar (opens in a new tab)`} title="Google Scholar">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3Zm-6 9.2V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-3.8l-6 3.3-6-3.3Z"/></svg>
                    </a>
                  )}
                </div>
              )}

              {member.highlights && (
                <details class="member-more">
                  <summary>Highlights &amp; publications</summary>
                  <div class="member-more-panel">
                  <ul class="more-highlights">
                    {member.highlights.map((item) => <li>{item}</li>)}
                  </ul>
                  {member.publications && (
                    <ol class="more-papers">
                      {member.publications.map((pub) => (
                        <li>
                          <a href={pub.href} target="_blank" rel="noopener noreferrer">
                            <span class="paper-title">{pub.title || 'Read the paper'}</span>
                            <span class="paper-venue">{pub.publisher}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  )}
                  </div>
                </details>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>


<style>
  /* Main page */
  .team-page {
    overflow: clip;
  }

  /* Hero section */
  .team-hero {
    min-height: 370px;
    padding: clamp(64px, 10vw, 120px) clamp(24px, 5vw, 64px) 44px;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 40px;
  }

  .team-hero-content {
    max-width: 780px;
    margin-inline: auto;
  }

  .team-hero h1 {
    margin-top: 22px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.99;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  .team-hero h1 span {
    color: var(--muted);
  }

  .team-intro {
    max-width: 540px;
    margin: 24px auto 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .team-hero-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--muted);
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px rgb(25 200 234 / 25%);
  }

  /* Team section */
  .team-section {
    padding: clamp(56px, 8vw, 100px) clamp(24px, 5vw, 64px);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }

  .section-heading h2,
  .team-closing h2 {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .section-description {
    max-width: 340px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  /* Three cards per row on desktop */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 40px;
    align-items: stretch;
  }

  /* Individual card */
  .team-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-2);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .team-card:hover {
    border-color: var(--line-2);
    transform: translateY(-3px);
  }

  /* Portrait area
     Future profile images will fill this rectangular area */
  .member-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background:
      radial-gradient(
        ellipse at 50% 100%,
        rgb(25 200 234 / 10%),
        transparent 58%
      ),
      var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .portrait-index,
  .portrait-caption {
    position: absolute;
    z-index: 1;
    color: var(--muted);
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .portrait-index {
    top: 14px;
    left: 14px;
  }

  .portrait-caption {
    right: 14px;
    bottom: 14px;
    font-size: 9px;
  }

  /* Temporary initials placeholder
     Replace this element with an image when photos are available */
  .member-placeholder {
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: var(--bg);
    color: var(--accent);
  }

  .member-placeholder span {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  /* Member information */
  .member-info {
    flex: 1;
    padding: 22px;
  }

  .member-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .member-heading > div {
    min-width: 0;
  }

  .member-heading h3 {
    font-size: 19px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .member-role {
    margin-top: 6px;
    color: var(--accent);
    font-size: 13px;
    line-height: 1.6;
  }

  .member-bio {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  /* LinkedIn link */
  .member-social {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .member-social:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .member-social svg {
    width: 15px;
    height: 15px;
  }

  /* Optional closing section */
  .team-closing {
    margin: 0 clamp(24px, 5vw, 64px) clamp(56px, 8vw, 96px);
    padding: clamp(32px, 6vw, 64px);
    border: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse at 100% 0%,
        rgb(25 200 234 / 7%),
        transparent 50%
      ),
      var(--bg-2);
  }

  .team-closing h2 {
    max-width: 620px;
  }

  .team-closing > p {
    max-width: 500px;
    margin-top: 16px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .team-closing .btn {
    margin-top: 28px;
  }

  /* Tablet: two cards per row */
  @media (min-width: 641px) and (max-width: 1000px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 32px;
    }

    .member-info {
      padding: 20px;
    }
  }

  /* Mobile: one card per row */
  @media (max-width: 640px) {
    .team-hero {
      min-height: 330px;
      padding: 64px 22px 32px;
      gap: 36px;
    }

    .team-hero h1 {
      font-size: clamp(42px, 12vw, 62px);
    }

    .team-intro {
      font-size: 15px;
    }

    .team-section {
      padding: 56px 22px;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 32px;
    }

    .team-grid {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
      row-gap: 28px;
    }

    .member-portrait {
      aspect-ratio: 4 / 3;
    }

    .member-placeholder {
      width: 96px;
      height: 96px;
    }

    .member-info {
      padding: 20px;
    }

    .member-heading h3 {
      font-size: 20px;
    }

    .team-closing {
      margin: 0 22px 56px;
      padding: 28px 22px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .team-card {
      transition: none;
    }

    .team-card:hover {
      transform: none;
    }
  }

  /* Layout refinements: compact hero, centred section heading, four cards per row */
  .team-hero {
    min-height: 0;
    padding: clamp(28px, 4vw, 48px) clamp(24px, 5vw, 64px) 36px;
    gap: 22px;
    background: radial-gradient(ellipse at 50% 0%, rgb(25 200 234 / 9%), transparent 62%);
  }

  .team-hero h1 {
    margin-top: 14px;
    font-size: clamp(36px, 4.6vw, 64px);
  }

  .team-intro {
    margin: 16px auto 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .team-hero-note {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-2);
  }

  .team-section {
    padding: clamp(36px, 5vw, 64px) clamp(24px, 5vw, 64px) clamp(48px, 6vw, 80px);
  }

  .section-heading {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .section-description {
    max-width: 460px;
    margin-inline: auto;
  }

  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .team-card {
    flex: 0 0 calc((100% - 72px) / 4);
    border-radius: 14px;
  }

  .member-portrait {
    aspect-ratio: 1 / 1;
  }

  .member-info {
    padding: 18px 20px 20px;
    text-align: center;
  }

  .member-heading {
    justify-content: center;
  }

  .member-heading h3 {
    font-size: 17px;
    line-height: 1.3;
  }

  @media (min-width: 641px) and (max-width: 1000px) {
    .team-card { flex-basis: calc((100% - 24px) / 2); }
  }

  @media (max-width: 640px) {
    .team-hero { padding: 28px 22px 28px; gap: 18px; }
    .team-card { flex-basis: 100%; }
    .member-portrait { aspect-ratio: 4 / 3; }
  }

  /* Plain, flat photo slots: no gradients, tags or numbering */
  .member-portrait {
    background: var(--surface);
  }

  .portrait-silhouette {
    width: 46%;
    height: auto;
    fill: none;
    stroke: var(--line-2);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .member-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-hero {
    background: none;
  }

  /* Labelled profile links, highlights and publications */
  .member-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }

  .member-link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--text);
    line-height: 1;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .member-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .member-link svg {
    width: 16px;
    height: 16px;
  }

  /* Profile icons sit in the top-right corner of the card */
  .team-card {
    position: relative;
    align-self: flex-start;
  }

  .member-links {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .member-link {
    width: 34px;
    height: 34px;
    background: rgb(17 15 13 / 72%);
    backdrop-filter: blur(6px);
  }

  /* Name and role sit close together */
  .member-heading h3 {
    line-height: 1.2;
  }

  .member-role {
    margin-top: 2px;
    line-height: 1.35;
  }

  /* Highlights and publications at the bottom of the card */
  .member-more {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    text-align: left;
    font-size: 13px;
  }

  .member-more summary {
    cursor: pointer;
    color: var(--accent);
    text-align: center;
  }

  .more-highlights {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--muted);
    line-height: 1.55;
  }

  .more-highlights li {
    position: relative;
    padding-left: 14px;
  }

  .more-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .more-papers {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .more-papers li {
    border-bottom: 1px solid var(--line);
  }

  .more-papers a {
    display: block;
    padding: 10px 0;
    color: var(--text);
    transition: color 180ms ease;
  }

  .more-papers a:hover {
    color: var(--accent);
  }

  .paper-title {
    display: block;
    line-height: 1.4;
  }

  .paper-venue {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 12px;
  }

  /* Dropdown opens upward over the card photo instead of pushing content down */
  .member-more {
    position: relative;
  }

  .member-more summary {
    color: #fff;
    list-style: none;
  }

  .member-more summary::-webkit-details-marker {
    display: none;
  }

  .member-more summary::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 180ms ease;
  }

  .member-more[open] summary::after {
    transform: translateY(1px) rotate(-135deg);
  }

  .member-more-panel {
    display: none;
  }

  .member-more[open] .member-more-panel {
    display: block;
    position: absolute;
    left: -20px;
    right: -20px;
    bottom: calc(100% + 15px);
    max-height: min(340px, 60vh);
    overflow-y: auto;
    padding: 16px 20px;
    border-top: 1px solid var(--line-2);
    background: rgb(17 15 13 / 96%);
    backdrop-filter: blur(8px);
    box-shadow: 0 -12px 32px rgb(0 0 0 / 45%);
    z-index: 3;
  }

  .member-more[open] .more-highlights {
    margin-top: 0;
  }

  /* Let the dropdown overflow the card; round the photo corners instead of clipping the card */
  .team-card {
    overflow: visible;
  }

  .member-portrait {
    border-radius: 14px 14px 0 0;
  }

  .team-card:has(.member-more[open]) {
    z-index: 10;
  }

  .member-more[open] .member-more-panel {
    left: -8px;
    right: -8px;
    bottom: calc(100% + 18px);
    max-height: none;
    overflow: visible;
    padding: 18px 20px 8px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: #17140f;
    box-shadow: 0 18px 48px rgb(0 0 0 / 60%);
    animation: more-in 160ms ease-out;
  }

  .member-more-panel .more-highlights {
    margin: 0 0 14px;
    gap: 10px;
    font-size: 13.5px;
  }

  .member-more-panel .more-papers {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .member-more-panel .more-papers li:last-child {
    border-bottom: 0;
  }

  @keyframes more-in {
