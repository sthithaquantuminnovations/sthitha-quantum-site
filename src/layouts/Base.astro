---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EdgeFx from '../components/EdgeFx.astro';
import { company } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, type = 'website', publishedTime, imageAlt = 'Sthitha Quantum Innovations logo', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL('/assets/images/sthitha-logo.png', Astro.site);

const organization: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: company.name,
  legalName: company.legalName,
  url: Astro.site?.href,
  logo: new URL('/assets/images/sthitha-logo-icon.png', Astro.site).href,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Landmark Towers, MG Road',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: '560001',
    addressCountry: 'IN',
  },
};
const profiles = company.social.filter((s) => s.href).map((s) => s.href);
if (profiles.length) organization.sameAs = profiles;
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: Astro.site?.href,
  name: company.name,
  publisher: { '@id': organization['@id'] },
};
const graph = [organization, website, ...(jsonLd ? [jsonLd].flat() : [])];
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_IN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="Sthitha Quantum Innovations" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={structuredData} is:inline />
    <meta name="theme-color" content="#110f0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Marks the page as scripted before first paint, so reveal states never flash. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1120941297253219');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1120941297253219&ev=PageView&noscript=1" alt="" /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <EdgeFx />
    <script>
      import '../scripts/visuals.js';
      import '../scripts/main.js';
    </script>
  </body>
</html>
