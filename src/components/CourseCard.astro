---
// A course always leads with its real thumbnail, and always sits under Sthitha Academy.
import { Image } from 'astro:assets';
import More from './More.astro';

interface Props {
  course: {
    href: string;
    title: string;
    subtitle: string;
    status: string;
    available: boolean;
    image: ImageMetadata;
    imageAlt: string;
  };
  delay?: number;
  summary?: string[];
  topics?: string[];
  number?: string;
}

const { course, delay = 0, summary = [], topics = [], number } = Astro.props;
---

<article class="course-card" data-fade style={`--d:${delay}ms`}>
  <a class="course-media" href={course.href} tabindex="-1" aria-hidden="true">
    <Image src={course.image} alt="" widths={[480, 750, 1100]} sizes="(max-width: 899px) 100vw, 620px" />
    <span class:list={['course-status', { 'is-soon': !course.available }]}>{course.status}</span>
  </a>
  <div class="course-body">
    <span class="course-label">{number ? `Course ${number} · ` : ''}Sthitha Academy</span>
    <h3><a href={course.href}>{course.title}</a></h3>
    <p class="course-sub">{course.subtitle}</p>
    {summary.map((t) => <p class="course-text">{t}</p>)}
    {topics.length > 0 && (
      <>
        <p class="course-text course-topics-label">What you'll explore</p>
        <ul class="ticks course-topics">{topics.map((t) => <li>{t}</li>)}</ul>
      </>
    )}
  </div>
  <div class="course-foot">
    <More href={course.href}>{course.available ? 'View course' : 'Course details'}</More>
  </div>
</article>
