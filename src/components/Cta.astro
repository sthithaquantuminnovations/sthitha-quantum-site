---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="cta">
  <canvas data-visual="burst" aria-hidden="true"></canvas>
  <div class="cta-inner">
    <h2 data-reveal>{title}</h2>
    <p data-fade style="--d:350ms">{text}</p>
    <div class="cta-actions" data-fade style="--d:450ms">
      <slot />
    </div>
  </div>
</section>
