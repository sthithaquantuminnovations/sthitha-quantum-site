---
import More from '../More.astro';

const approach = [
  {
    id: 'discover', title: 'Discover',
    text: 'Find cryptographic assets across your systems and understand where they are being used.',
    points: ['Cryptographic discovery', 'Asset inventory', 'Where each asset is used'],
  },
  {
    id: 'protect', title: 'Protect',
    text: 'Assess quantum exposure and prepare appropriate post-quantum protection strategies.',
    points: ['Risk assessment', 'Quantum exposure', 'Protection strategies'],
  },
  {
    id: 'migrate', title: 'Migrate',
    text: 'Build a clear, phased roadmap for moving critical systems towards post-quantum cryptography.',
    points: ['Migration planning', 'Phased roadmap', 'Reporting'],
  },
];
---

<section class="section" id="aegis">
  <div class="section-head">
    <span class="eyebrow">AEGIS · A Sthitha initiative</span>
    <h2 data-reveal>Preparing critical systems for the post-quantum era.</h2>
    <p data-fade style="--d:200ms">AEGIS helps organisations discover where cryptography is being used, understand their exposure and prepare a practical path towards post-quantum security.</p>
  </div>

  <div class="cells" id="capabilities">
    {approach.map((step, i) => (
      <article class="cell" data-fade style={`--d:${i * 90}ms`}>
        <div class="cell-num"><span>0{i + 1}</span><span>AEGIS</span></div>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
        <ul class="ticks">{step.points.map((point) => <li>{point}</li>)}</ul>
        <More href={`/aegis#${step.id}`}>Explore AEGIS</More>
      </article>
    ))}
  </div>
</section>
