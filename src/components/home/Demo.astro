---
import Icon from '../Icon.astro';
---

<section class="section demo-section">
  <div class="demo-stage">
    <canvas data-visual="waves" aria-hidden="true"></canvas>
    <div class="demo" data-demo data-state="typing" aria-hidden="true">
      <div class="demo-prompt">
        <div class="demo-line">
          <span class="demo-typed" data-placeholder="Ask about your cryptographic environment" data-query="Which cryptographic assets are most exposed?"></span>
          <span class="demo-caret"></span>
          <span class="demo-count">3 Results</span>
        </div>
        <div class="demo-tools"><Icon name="plus" /><Icon name="send" /></div>
      </div>
      <div class="demo-chips">
        <span class="chip"><Icon name="scan" />Discover</span>
        <span class="chip"><Icon name="shield" />Protect</span>
        <span class="chip"><Icon name="route" />Migrate</span>
      </div>
      <div class="demo-scan"><span>Reviewing RSA · ECC · SHA · TLS</span></div>

      <div class="demo-results">
        <div class="demo-meta">3 asset types · sorted by quantum exposure</div>
        <div class="demo-row">
          <span class="demo-ico"><Icon name="key" /></span>
          <span class="demo-name">RSA</span>
          <span class="demo-risk" style="--c:var(--red)">High exposure</span>
          <span class="badge is-red">TLS</span>
        </div>
        <div class="demo-row">
          <span class="demo-ico"><Icon name="cpu" /></span>
          <span class="demo-name">ECC</span>
          <span class="demo-risk" style="--c:var(--red)">High exposure</span>
          <span class="badge is-amber">Legacy systems</span>
        </div>
        <div class="demo-row">
          <span class="demo-ico"><Icon name="hash" /></span>
          <span class="demo-name">SHA-256</span>
          <span class="demo-risk" style="--c:var(--green)">Lower exposure</span>
          <span class="badge">Hashing</span>
        </div>
      </div>
      <div class="demo-actions">
        <span class="chip"><Icon name="download" />Export inventory</span>
        <span class="chip"><Icon name="share" />Share report</span>
      </div>
    </div>
  </div>
  <p class="demo-note" data-fade>A visual illustration of the kind of visibility AEGIS aims to provide. The interfaces on this page are not a live product.</p>
</section>
