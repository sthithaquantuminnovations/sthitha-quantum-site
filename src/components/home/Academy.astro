---
import CourseCard from '../CourseCard.astro';
import More from '../More.astro';
import { courses } from '../../data/site.js';
---

<section class="section" id="academy">
  <div class="section-head">
    <span class="eyebrow is-brand">Start Your Quantum Journey</span>
    <h2 data-reveal>Learn <span class="hl">Quantum Computing</span> From the Fundamentals</h2>
    <p data-fade style="--d:200ms">Sthitha Academy introduces learners to quantum computing through accessible courses covering foundational concepts and quantum algorithms.</p>
    <More href="/academy" data-fade style="--d:300ms">Explore Academy</More>
  </div>

  <div class="course-grid">
    {courses.map((course, i) => <CourseCard course={course} delay={i * 110} />)}
  </div>
</section>
