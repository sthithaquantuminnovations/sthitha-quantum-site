---
import Announce from '../Announce.astro';
import { areas } from '../../data/site.js';
---

<section class="hero">
  <Announce pill="Sthitha" text="Sthitha Quantum Innovations" />

  <div class="hero-grid">
    <div class="hero-copy">
      <h1 data-reveal>Building Technology<br />for the Quantum Era</h1>
      <p class="hero-lede" data-fade style="--d:250ms">Sthitha Quantum Innovations works across quantum computing, post-quantum security, education and research to build practical pathways into the quantum era.</p>
      <div class="hero-actions" data-fade style="--d:380ms">
        <a class="btn btn-light" href="#work">Explore Our Work</a>
        <a class="btn btn-dark" href="/about">About Sthitha</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true"><canvas data-visual="atom"></canvas></div>
  </div>

  <ol class="hero-steps">
    {areas.map((area, i) => (
      <li data-fade style={`--d:${450 + i * 80}ms`}>
        <h3><span>{i + 1}.</span> <a href={area.href}>{area.name}</a></h3>
        <p>{area.short}</p>
      </li>
    ))}
  </ol>
</section>
