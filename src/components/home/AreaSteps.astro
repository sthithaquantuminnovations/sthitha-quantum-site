---
import { areas } from '../../data/site.js';
---

<section class="section" aria-label="Sthitha's areas of work">
  <ol class="hero-steps">
    {areas.map((area, i) => (
      <li data-fade style={`--d:${i * 80}ms`}>
        <h3><span>{i + 1}.</span> <a href={area.href}>{area.name}</a></h3>
        <p>{area.short}</p>
      </li>
    ))}
  </ol>
</section>
